{
  "comments": { "mode": "block" },
  "pull_request": { "mode": "block" },
  "rules": { "mode": "block" },
  "judge": {
    "enabled": false,
    "mode": "warn",
    "when": ["commit", "pr"],
    "provider": "session",
    "api": {
      "base_url": "https://api.openai.com/v1",
      "model": "gpt-4o-mini",
      "api_key_env": "OPENAI_API_KEY",
      "timeout": 30
    },
    "max_diff_chars": 12000
  }
}
